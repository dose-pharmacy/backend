NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
BODY_LIMIT=100kb
DATABASE_URL=postgresql://username:password@localhost:5432/pharmacy?schema=public


BETTER_AUTH_SECRET=ba_zqmupl37p0rln2lb8fl4vq4belo1l1ll
BETTER_AUTH_URL=https://your-domain.example.com

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

FRONTEND_URL=https://your-frontend.example.com

TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_PSM=6
TESSERACT_LANG=eng
TESSDATA_PREFIX=/usr/share/tessdata

# Upper bound only: smaller photos are NOT enlarged.
TESSERACT_TARGET_WIDTH=1800
TESSERACT_TIMEOUT_MS=60000

# Tesseract is OpenMP-parallel; pin it to one thread on CPU-limited hosts.
OMP_THREAD_LIMIT=1
OMP_NUM_THREADS=1

# Maximum simultaneous Tesseract processes per Node process.
OCR_MAX_CONCURRENCY=1
