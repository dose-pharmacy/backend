generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Auth & User
// ============================================================

enum UserRole {
  ADMIN
  PHARMACIST
  CASHIER
  INVENTORY_MANAGER
  MANAGER
}

// ============================================================
// Inventory Enums
// ============================================================

enum StockDirection {
  IN
  OUT
}

enum StockTransactionType {
  OPENING
  PURCHASE
  SALE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  EXPIRY
  DISPOSAL
  CORRECTION
  RETURN_TO_SUPPLIER
  CLEARANCE_SALE
}

enum TransferStatus {
  DRAFT
  PENDING
  COMPLETED
  CANCELLED
}

enum ExpiryActionType {
  RETURN_TO_SUPPLIER
  CLEARANCE_SALE
  DISPOSE
}

// ============================================================
// Audit Trail
// ============================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  APPROVE
  REJECT
  CANCEL
  COMPLETE
  // Business transitions that are neither plain updates nor cancellations.
  CONFIRM
  CLOSE
}

enum AuditEntity {
  USER
  PRODUCT
  BATCH
  STOCK_TRANSACTION
  STOCK_TRANSFER
  PURCHASE_ORDER
  GOODS_RECEIPT
  SUPPLIER_INVOICE
  SUPPLIER_PAYMENT
  PURCHASE_RETURN
  SALE
  PAYMENT
  SUPPLIER
  LOCATION
  EXPIRY_ACTION
  REORDER_CONFIG
  DISCOUNT_AUTH_RULE
  SLOW_MOVING_CONFIG
  GENERIC_PRODUCT
  MANUFACTURER
  PURCHASE_REQUIREMENT
}

// ============================================================
// Purchasing & Supplier Management (Phase 3)
// ============================================================

enum PurchaseRequirementStatus {
  OPEN
  PARTIALLY_FULFILLED
  FULFILLED
  CLOSED
}

enum PurchaseRequirementReason {
  LOW_STOCK
  REORDER_ALERT
  MANUAL
}

enum PurchaseOrderStatus {
  AWAITING_DELIVERY
  RECEIVED
  CLOSED
  CANCELLED
}

// Derived (never persisted) payment status of a purchase order, aggregated
// across ALL of the order's supplier invoices and their payments.
enum PurchaseOrderPaymentStatus {
  NOT_INVOICED
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum GoodsReceiptStatus {
  MATCHED
  DISCREPANCY
  RESOLVED
}

enum SupplierInvoiceStatus {
  OPEN
  PARTIALLY_PAID
  PAID
}

enum PurchaseReturnReason {
  EXPIRED
  DAMAGED
  INCORRECT_DELIVERY
}

// ============================================================
// POS & Sales Enums
// ============================================================

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  DIGITAL_TRANSFER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// ============================================================
// Financials, Reporting & Analytics (Phase 4)
// ============================================================

enum DiscountScope {
  ITEM
  BILL
}

enum SlowMovingDefinition {
  DAYS_30
  DAYS_60
  DAYS_90
  DAYS_180
  CUSTOM
}

// ============================================================
// Models
// ============================================================

model User {
  id                     String                @id
  name                   String
  email                  String
  emailVerified          Boolean               @default(false)
  image                  String?
  role                   UserRole              @default(ADMIN)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  sessions               Session[]
  accounts               Account[]
  stockTransactions      StockTransaction[]
  stockTransfers         StockTransfer[]       @relation("CreatedStockTransfers")
  expiryActions          ExpiryAction[]        @relation("PerformedExpiryActions")
  cashierSales           Sale[]                @relation("CashierSales")
  cancelledSales         Sale[]                @relation("CancelledSales")
  purchaseRequirements   PurchaseRequirement[] @relation("CreatedPurchaseRequirements")
  purchaseOrders         PurchaseOrder[]       @relation("CreatedPurchaseOrders")
  goodsReceipts          GoodsReceipt[]        @relation("CreatedGoodsReceipts")
  confirmedGoodsReceipts GoodsReceipt[]        @relation("ConfirmedGoodsReceipts")
  supplierInvoices       SupplierInvoice[]     @relation("CreatedSupplierInvoices")
  supplierPayments       SupplierPayment[]     @relation("RecordedSupplierPayments")
  purchaseReturns        PurchaseReturn[]      @relation("RecordedPurchaseReturns")
  recordedPayments       Payment[]             @relation("RecordedPayments")
  auditTrails            AuditTrail[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// Inventory Core Domain (Phase 1)
// ============================================================

model ProductGroup {
  id                  String    @id @default(uuid())
  name                String
  description         String?
  defaultProfitMargin Decimal   @default(0) @db.Decimal(5, 2)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  products            Product[]

  @@unique([name])
  @@index([isActive])
  @@map("product_group")
}

model Unit {
  id          String   @id @default(uuid())
  name        String
  symbol      String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  productUnits  ProductUnit[]
  transferItems StockTransferItem[]
  saleItems     SaleItem[]
  requirementLines PurchaseRequirementLine[] @relation("RequirementLineUnit")
  purchaseOrderItems PurchaseOrderItem[]    @relation("PurchaseOrderItemUnit")
  goodsReceiptItems GoodsReceiptItem[]       @relation("GoodsReceiptItemUnit")
  stockTransactions StockTransaction[] @relation("StockTransactionUnit")
  supplierInvoiceItems SupplierInvoiceItem[]
  purchaseReturns  PurchaseReturn[]

  @@unique([name])
  @@index([isActive])
  @@map("unit")
}

model Product {
  id               String          @id @default(uuid())
  name             String
  genericName      String?
  brand            String?
  sku              String
  description      String?
  imageUrl         String?
  minimumStock     Decimal         @default(0) @db.Decimal(14, 3)
  reorderPoint     Decimal?        @db.Decimal(14, 3)
  isActive         Boolean         @default(true)
  // Narcotic / controlled product flag (MVP). A simple boolean is sufficient
  // today: the frontend uses it to show the prescription/reference reminder
  // and the narcotic report filters on it. Extend to an enum only when a
  // real classification need appears.
  isNarcotic       Boolean         @default(false)
  productGroupId   String
  productGroup     ProductGroup    @relation(fields: [productGroupId], references: [id])
  genericProductId String?
  genericProduct   GenericProduct? @relation(fields: [genericProductId], references: [id])
  manufacturerId   String?
  manufacturer     Manufacturer?   @relation(fields: [manufacturerId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  units                    ProductUnit[]
  batches                  Batch[]
  stock                    InventoryStock[]
  transactions             StockTransaction[]
  transferItems            StockTransferItem[]
  reorderConfig            ReorderConfiguration?
  purchaseRequirementLines PurchaseRequirementLine[]
  purchaseOrderItems       PurchaseOrderItem[]
  purchaseReturns          PurchaseReturn[]
  saleItems                SaleItem[]
  saleLines                SaleLine[]
  slowMovingConfiguration  SlowMovingConfiguration?

  @@unique([sku])
  @@index([productGroupId])
  @@index([genericProductId])
  @@index([manufacturerId])
  @@index([name])
  @@index([isActive])
  @@index([isNarcotic])
  @@map("product")
}

model ProductUnit {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  unitId           String
  unit             Unit     @relation(fields: [unitId], references: [id])
  conversionFactor Decimal  @db.Decimal(12, 4)
  sellPrice        Decimal? @db.Decimal(12, 2)
  purchasePrice    Decimal? @db.Decimal(12, 2)
  isBaseUnit       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([productId, unitId])
  @@index([productId, isBaseUnit])
  @@index([unitId])
  @@map("product_unit")
}

model InventoryLocation {
  id                String             @id @default(uuid())
  name              String
  description       String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  stock             InventoryStock[]
  transactions      StockTransaction[]
  fromTransfers     StockTransfer[]    @relation("FromLocation")
  toTransfers       StockTransfer[]    @relation("ToLocation")
  expiryActions     ExpiryAction[]
  goodsReceiptItems GoodsReceiptItem[]
  purchaseReturns   PurchaseReturn[]
  sales             Sale[]

  @@unique([name])
  @@index([isActive])
  @@map("inventory_location")
}

model Batch {
  id                String              @id @default(uuid())
  productId         String
  product           Product             @relation(fields: [productId], references: [id])
  batchNumber       String
  manufacturingDate DateTime?
  receivedDate      DateTime?
  expiryDate        DateTime
  purchaseCost      Decimal?            @db.Decimal(12, 2)
  supplierReference String?
  supplierId        String?
  supplier          Supplier?           @relation(fields: [supplierId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  stock             InventoryStock[]
  transactions      StockTransaction[]
  transferItems     StockTransferItem[]
  expiryActions     ExpiryAction[]
  goodsReceiptItems GoodsReceiptItem[]
  purchaseReturns   PurchaseReturn[]
  saleItemBatches   SaleItemBatch[]

  @@unique([productId, batchNumber])
  @@index([productId, expiryDate])
  @@index([batchNumber])
  @@map("batch")
}

model InventoryStock {
  id               String            @id @default(uuid())
  productId        String
  product          Product           @relation(fields: [productId], references: [id])
  batchId          String
  batch            Batch             @relation(fields: [batchId], references: [id])
  locationId       String
  location         InventoryLocation @relation(fields: [locationId], references: [id])
  quantity         Decimal           @default(0) @db.Decimal(14, 3)
  reservedQuantity Decimal           @default(0) @db.Decimal(14, 3)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([batchId, locationId])
  @@index([productId])
  @@index([locationId])
  @@map("inventory_stock")
}

model StockTransaction {
  id              String               @id @default(uuid())
  productId       String
  product         Product              @relation(fields: [productId], references: [id])
  batchId         String
  batch           Batch                @relation(fields: [batchId], references: [id])
  locationId      String
  location        InventoryLocation    @relation(fields: [locationId], references: [id])
  transactionType StockTransactionType
  direction       StockDirection
  quantity        Decimal              @db.Decimal(14, 3)
  balanceAfter    Decimal              @db.Decimal(14, 3)
  // Conversion snapshot: the unit the originating transaction was entered in
  // and the factor used to normalize it to base units. Null on legacy rows and
  // movements without an original unit. `quantity` is ALWAYS base units.
  unitId          String?
  unit            Unit?                @relation("StockTransactionUnit", fields: [unitId], references: [id])
  conversionFactor Decimal?            @db.Decimal(12, 4)
  referenceType   String?
  referenceId     String?
  notes           String?
  createdById     String
  createdBy       User                 @relation(fields: [createdById], references: [id])
  createdAt       DateTime             @default(now())

  @@index([productId, createdAt])
  @@index([batchId, createdAt])
  @@index([locationId, createdAt])
  @@index([transactionType])
  @@index([createdById])
  @@map("stock_transaction")
}

// ============================================================
// Inventory Operations & Expiry Control (Phase 2)
// ============================================================

model StockTransfer {
  id             String              @id @default(uuid())
  fromLocationId String
  fromLocation   InventoryLocation   @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     InventoryLocation   @relation("ToLocation", fields: [toLocationId], references: [id])
  transferDate   DateTime            @default(now())
  reason         String?
  status         TransferStatus      @default(DRAFT)
  createdById    String
  createdBy      User                @relation("CreatedStockTransfers", fields: [createdById], references: [id])
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  items          StockTransferItem[]

  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
  @@index([createdById])
  @@map("stock_transfer")
}

model StockTransferItem {
  id           String        @id @default(uuid())
  transferId   String
  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId    String
  product      Product       @relation(fields: [productId], references: [id])
  batchId      String
  batch        Batch         @relation(fields: [batchId], references: [id])
  unitId       String
  unit         Unit          @relation(fields: [unitId], references: [id])
  quantity     Decimal       @db.Decimal(14, 3)
  baseQuantity Decimal       @db.Decimal(14, 3)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([transferId, productId, batchId, unitId])
  @@index([transferId])
  @@index([productId])
  @@index([batchId])
  @@index([unitId])
  @@map("stock_transfer_item")
}

model ExpiryAction {
  id              String             @id @default(uuid())
  batchId         String
  batch           Batch              @relation(fields: [batchId], references: [id])
  actionType      ExpiryActionType
  quantity        Decimal?           @db.Decimal(14, 3)
  locationId      String?
  location        InventoryLocation? @relation(fields: [locationId], references: [id])
  supplierId      String?
  supplier        Supplier?          @relation(fields: [supplierId], references: [id])
  discountPercent Decimal?           @db.Decimal(5, 2)
  reason          String?
  notes           String?
  performedById   String
  performedBy     User               @relation("PerformedExpiryActions", fields: [performedById], references: [id])
  createdAt       DateTime           @default(now())

  @@index([batchId])
  @@index([actionType])
  @@index([performedById])
  @@map("expiry_action")
}

model ReorderConfiguration {
  id                String   @id @default(uuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id])
  minimumStockLevel Decimal  @db.Decimal(14, 3)
  reorderPoint      Decimal  @db.Decimal(14, 3)
  leadTimeDays      Int      @default(7)
  reorderQuantity   Decimal  @db.Decimal(14, 3)
  useSalesVelocity  Boolean  @default(false)
  bufferPercentage  Decimal  @default(20) @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("reorder_configuration")
}

// ============================================================
// Purchasing & Supplier Management (Phase 3)
// ============================================================

model Supplier {
  id            String   @id @default(uuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  paymentTerms  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batches          Batch[]
  expiryActions    ExpiryAction[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  supplierInvoices SupplierInvoice[]
  supplierPayments SupplierPayment[]
  purchaseReturns  PurchaseReturn[]

  @@unique([name])
  @@index([isActive])
  @@map("supplier")
}

model PurchaseRequirement {
  id          String                    @id @default(uuid())
  reference   String
  status      PurchaseRequirementStatus @default(OPEN)
  requiredBy  DateTime?
  notes       String?
  createdById String
  createdBy   User                      @relation("CreatedPurchaseRequirements", fields: [createdById], references: [id])
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  lines       PurchaseRequirementLine[]

  @@unique([reference])
  @@index([status])
  @@index([createdById])
  @@map("purchase_requirement")
}
model PurchaseRequirementLine {
  id                String                     @id @default(uuid())
  requirementId     String
  requirement       PurchaseRequirement        @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  productId         String
  product           Product                    @relation(fields: [productId], references: [id])
  // Unit the requirement is expressed in (e.g. "Box"). Null = legacy line
  // created before units; such lines are interpreted in the product's base unit.
  unitId            String?
  unit              Unit?                      @relation("RequirementLineUnit", fields: [unitId], references: [id])
  quantityNeeded    Decimal                    @db.Decimal(14, 3)
  // Snapshot of quantityNeeded x conversionFactor at line creation/update.
  // Fulfillment math normalizes through base quantities.
  quantityNeededBase Decimal                   @default(0) @db.Decimal(14, 3)
  quantityDelivered Decimal                    @default(0) @db.Decimal(14, 3)
  reasonCode        PurchaseRequirementReason?
  status            PurchaseRequirementStatus  @default(OPEN)
  notes             String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  // Direct FK kept for backward compatibility of existing PO items that may still
  // point at a single requirement line. New partial/multi-PO fulfillment is handled
  // through PurchaseRequirementAllocation.
  purchaseOrderItems PurchaseOrderItem[]
  allocations        PurchaseRequirementAllocation[]

  @@unique([requirementId, productId])
  @@index([productId])
  @@map("purchase_requirement_line")
}

model PurchaseOrder {
  id                   String                          @id @default(uuid())
  poNumber             String
  supplierId           String
  supplier             Supplier                        @relation(fields: [supplierId], references: [id])
  status               PurchaseOrderStatus             @default(AWAITING_DELIVERY)
  orderDate            DateTime                        @default(now())
  expectedDeliveryDate DateTime?
  notes                String?
  createdById          String
  createdBy            User                            @relation("CreatedPurchaseOrders", fields: [createdById], references: [id])
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  items                PurchaseOrderItem[]
  goodsReceipts        GoodsReceipt[]
  supplierInvoices     SupplierInvoice[]

  @@unique([poNumber])
  @@index([supplierId])
  @@index([status])
  @@index([createdById])
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id                String                          @id @default(uuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder                   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  requirementLineId String?
  requirementLine   PurchaseRequirementLine?        @relation(fields: [requirementLineId], references: [id], onDelete: SetNull)
  productId         String
  product           Product                         @relation(fields: [productId], references: [id])
  // Unit the item is ordered in (e.g. "Box"). Null = legacy item (base unit).
  unitId            String?
  unit              Unit?                           @relation("PurchaseOrderItemUnit", fields: [unitId], references: [id])
  quantityOrdered   Decimal                         @db.Decimal(14, 3)
  // Snapshot of quantityOrdered x conversionFactor at order time. Historical
  // transactions never depend on the current ProductUnit configuration.
  quantityOrderedBase Decimal                       @default(0) @db.Decimal(14, 3)
  quantityReceived  Decimal                         @default(0) @db.Decimal(14, 3)
  // Explicitly accepted shortfall: ordered units that will NOT be delivered.
  // Purely accounting/reconciliation — never increases stock.
  quantityShort     Decimal                         @default(0) @db.Decimal(14, 3)
  // Why the shortfall was accepted (free text, kept simple; e.g. "supplier
  // discontinued", "damaged in transit").
  shortReason       String?
  unitCost          Decimal                         @db.Decimal(12, 2)
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  goodsReceiptItems GoodsReceiptItem[]
  allocations       PurchaseRequirementAllocation[]
  invoiceItems      SupplierInvoiceItem[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([requirementLineId])
  @@map("purchase_order_item")
}

// Explicit allocation between a requirement line and a purchase-order item.
// A requirement line may be fulfilled by many purchase-order items (one row per
// PO item), from potentially different suppliers. The purchase order (and hence
// the supplier) is reached through `purchaseOrderItem`; the allocation is only
// considered "active" while that purchase order is not CANCELLED, so cancelling a
// purchase order automatically releases its quantity without deleting history.
model PurchaseRequirementAllocation {
  id                  String                  @id @default(uuid())
  requirementLineId   String
  requirementLine     PurchaseRequirementLine @relation(fields: [requirementLineId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem       @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  quantityAllocated   Decimal                 @db.Decimal(14, 3)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([requirementLineId, purchaseOrderItemId])
  @@index([requirementLineId])
  @@index([purchaseOrderItemId])
  @@map("purchase_requirement_allocation")
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  receiptNumber   String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  supplierId      String
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  receivedDate    DateTime           @default(now())
  status          GoodsReceiptStatus @default(MATCHED)
  discrepancyNote String?
  confirmedById   String?
  confirmedBy     User?              @relation("ConfirmedGoodsReceipts", fields: [confirmedById], references: [id])
  createdById     String
  createdBy       User               @relation("CreatedGoodsReceipts", fields: [createdById], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  items           GoodsReceiptItem[]

  @@unique([receiptNumber])
  @@index([purchaseOrderId])
  @@index([status])
  @@map("goods_receipt")
}

model GoodsReceiptItem {
  id                  String            @id @default(uuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  locationId          String
  location            InventoryLocation @relation(fields: [locationId], references: [id])
  expectedQty         Decimal           @db.Decimal(14, 3)
  deliveredQty        Decimal           @db.Decimal(14, 3)
  actualQty           Decimal           @db.Decimal(14, 3)
  // Unit the quantities are expressed in (the PO item's ordered unit, snapshotted
  // at receipt time so later unit changes never reinterpret history).
  unitId              String?
  unit                Unit?             @relation("GoodsReceiptItemUnit", fields: [unitId], references: [id])
  unitCost            Decimal           @db.Decimal(12, 2)
  batchNumber         String?
  manufacturingDate   DateTime?
  expiryDate          DateTime?
  batchId             String?
  batch               Batch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([goodsReceiptId, purchaseOrderItemId])
  @@index([purchaseOrderItemId])
  @@index([batchId])
  @@map("goods_receipt_item")
}

model SupplierInvoice {
  id                 String                @id @default(uuid())
  invoiceNumber      String
  supplierId         String
  supplier           Supplier              @relation(fields: [supplierId], references: [id])
  purchaseOrderId    String?
  purchaseOrder      PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  invoiceDate        DateTime              @default(now())
  dueDate            DateTime?
  // Financial breakdown. goodsAmount is the value of received goods being
  // billed; totalAmount is what the pharmacy actually owes.
  //   totalAmount = goodsAmount + taxAmount + additionalChargesAmount - discountAmount
  goodsAmount              Decimal               @db.Decimal(12, 2)
  taxAmount                Decimal               @default(0) @db.Decimal(12, 2)
  additionalChargesAmount  Decimal               @default(0) @db.Decimal(12, 2)
  discountAmount           Decimal               @default(0) @db.Decimal(12, 2)
  totalAmount              Decimal               @db.Decimal(12, 2)
  // Legacy single-amount field. Equals totalAmount for all invoices created
  // since the financial split was introduced; kept so old API consumers and
  // historical rows keep working.
  invoiceAmount      Decimal               @db.Decimal(12, 2)
  paymentTerms       String?
  // totalAmount minus the sum of recorded payments. Payments always settle
  // the invoice TOTAL, never the goods amount alone.
  outstandingBalance Decimal               @db.Decimal(12, 2)
  status             SupplierInvoiceStatus @default(OPEN)
  createdById        String
  createdBy          User                  @relation("CreatedSupplierInvoices", fields: [createdById], references: [id])
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  payments           SupplierPayment[]
  items              SupplierInvoiceItem[]

  @@unique([supplierId, invoiceNumber])
  @@index([supplierId])
  @@index([status])
  @@index([purchaseOrderId])
  @@map("supplier_invoice")
}

// Allocation of an invoice's goods against specific PO items and their
// received quantities. Prevents the same received goods from being invoiced
// twice: for each PO item, SUM(invoice items.quantity) across all of the PO's
// invoices must never exceed purchaseOrderItem.quantityReceived.
model SupplierInvoiceItem {
  id                  String            @id @default(uuid())
  invoiceId           String
  invoice             SupplierInvoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  // Quantity invoiced, in the PO item's ordered unit.
  quantity            Decimal           @db.Decimal(14, 3)
  unitId              String?
  unit                Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitCost            Decimal           @db.Decimal(12, 2)
  // quantity x unitCost, stored so the invoice's goods breakdown survives
  // later PO item edits.
  goodsAmount         Decimal           @db.Decimal(12, 2)
  createdAt           DateTime          @default(now())

  @@unique([invoiceId, purchaseOrderItemId])
  @@index([purchaseOrderItemId])
  @@index([invoiceId])
  @@map("supplier_invoice_item")
}

model SupplierPayment {
  id                String          @id @default(uuid())
  supplierInvoiceId String
  supplierInvoice   SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  supplierId        String
  supplier          Supplier        @relation(fields: [supplierId], references: [id])
  amount            Decimal         @db.Decimal(12, 2)
  paymentDate       DateTime        @default(now())
  notes             String?
  recordedById      String
  recordedBy        User            @relation("RecordedSupplierPayments", fields: [recordedById], references: [id])
  createdAt         DateTime        @default(now())

  @@index([supplierInvoiceId])
  @@map("supplier_payment")
}

model PurchaseReturn {
  id              String               @id @default(uuid())
  returnNumber    String
  supplierId      String
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  productId       String
  product         Product              @relation(fields: [productId], references: [id])
  batchId         String?
  batch           Batch?               @relation(fields: [batchId], references: [id])
  locationId      String
  location        InventoryLocation    @relation(fields: [locationId], references: [id])
  // Unit the return quantity was entered in (null = base unit / legacy rows).
  unitId          String?
  unit            Unit?                @relation(fields: [unitId], references: [id])
  // 1 unit = factor base units; snapshot for display (null when entered in base units).
  unitConversionFactor Decimal?        @db.Decimal(12, 4)
  reason          PurchaseReturnReason
  quantity        Decimal              @db.Decimal(14, 3)
  returnedDate    DateTime             @default(now())
  debitNoteAmount Decimal              @db.Decimal(12, 2)
  unitCost        Decimal              @db.Decimal(12, 2)
  notes           String?
  recordedById    String
  recordedBy      User                 @relation("RecordedPurchaseReturns", fields: [recordedById], references: [id])
  createdAt       DateTime             @default(now())

  @@index([supplierId])
  @@index([productId])
  @@index([batchId])
  @@index([unitId])
  @@map("purchase_return")
}

// ============================================================
// Retail Point of Sale (POS)
// ============================================================

model Sale {
  id                String            @id @default(uuid())
  saleNumber        String            @unique
  locationId        String
  location          InventoryLocation @relation(fields: [locationId], references: [id])
  status            SaleStatus        @default(DRAFT)
  subtotal          Decimal           @db.Decimal(12, 2)
  totalDiscount     Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal           @db.Decimal(12, 2)
  paidAmount        Decimal           @default(0) @db.Decimal(12, 2)
  changeAmount      Decimal           @default(0) @db.Decimal(12, 2)
  billDiscountType  DiscountType?
  billDiscountValue Decimal?          @db.Decimal(12, 2)
  cashierId         String
  cashier           User              @relation("CashierSales", fields: [cashierId], references: [id])
  notes             String?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelledById     String?
  cancelledBy       User?             @relation("CancelledSales", fields: [cancelledById], references: [id])
  cancelReason      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items       SaleItem[]
  payments    SalePayment[]
  lines       SaleLine[]
  paymentsFin Payment[]

  @@index([locationId])
  @@index([status])
  @@index([cashierId])
  @@index([createdAt])
  // Reporting scans filter on status + a createdAt range (optionally by
  // location). Composite indexes match those predicates directly instead of
  // intersecting the single-column indexes above.
  @@index([status, createdAt])
  @@index([status, locationId, createdAt])
  @@map("sale")
}

model SaleItem {
  id                String        @id @default(uuid())
  saleId            String
  sale              Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId         String
  product           Product       @relation(fields: [productId], references: [id])
  unitId            String
  unit              Unit          @relation(fields: [unitId], references: [id])
  quantity          Decimal       @db.Decimal(14, 3)
  baseQuantity      Decimal       @db.Decimal(14, 3)
  conversionFactor  Decimal       @db.Decimal(12, 4)
  originalUnitPrice Decimal       @db.Decimal(12, 2)
  actualUnitPrice   Decimal       @db.Decimal(12, 2)
  discountType      DiscountType?
  discountValue     Decimal?      @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(12, 2)
  lineTotal         Decimal       @db.Decimal(12, 2)
  createdAt         DateTime      @default(now())

  batchAllocations SaleItemBatch[]

  @@index([saleId])
  @@index([productId])
  @@index([unitId])
  @@map("sale_item")
}

model SaleItemBatch {
  id           String   @id @default(uuid())
  saleItemId   String
  saleItem     SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  batchId      String
  batch        Batch    @relation(fields: [batchId], references: [id])
  baseQuantity Decimal  @db.Decimal(14, 3)
  createdAt    DateTime @default(now())

  @@unique([saleItemId, batchId])
  @@index([batchId])
  @@map("sale_item_batch")
}

model SalePayment {
  id        String        @id @default(uuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  createdAt DateTime      @default(now())

  @@index([saleId])
  @@map("sale_payment")
}

// ============================================================
// Financials, Reporting & Analytics (Phase 4)
// ============================================================

model GenericProduct {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([name])
  @@index([name])
  @@map("generic_product")
}

model Manufacturer {
  id          String    @id @default(uuid())
  name        String
  contactInfo String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([name])
  @@index([isActive])
  @@map("manufacturer")
}

model SaleLine {
  id                 String   @id @default(uuid())
  saleId             String
  sale               Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId          String
  product            Product  @relation(fields: [productId], references: [id])
  unitSold           String
  quantity           Decimal  @db.Decimal(14, 3)
  quantityBaseUnits  Decimal  @db.Decimal(14, 3)
  unitPrice          Decimal  @db.Decimal(12, 2)
  itemDiscountAmount Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal          Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
  @@map("sale_line")
}

model Payment {
  id              String        @id @default(uuid())
  saleId          String
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  referenceNumber String?
  recordedById    String
  recordedBy      User          @relation("RecordedPayments", fields: [recordedById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([saleId])
  @@index([method])
  @@map("payment")
}

model DiscountAuthorizationRule {
  id                String        @id @default(uuid())
  scope             DiscountScope
  maxDiscountPct    Decimal       @db.Decimal(5, 2)
  roleRequiredAbove String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("discount_authorization_rule")
}

model SlowMovingConfiguration {
  id                String               @id @default(uuid())
  productId         String               @unique
  product           Product              @relation(fields: [productId], references: [id])
  definitionType    SlowMovingDefinition
  customDays        Int?
  lastSaleDate      DateTime?
  daysSinceLastSale Int?
  isFlagged         Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([isFlagged])
  @@index([definitionType])
  @@map("slow_moving_configuration")
}

// ============================================================
// Audit Trail
// ============================================================

model AuditTrail {
  id           String      @id @default(uuid())
  // Nullable so system/background operations (no authenticated actor) can
  // still be audited. Business flows always populate it from the session.
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  action       AuditAction
  entity       AuditEntity
  entityId     String
  oldData      Json?
  newData      Json?
  description  String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_trail")
}
