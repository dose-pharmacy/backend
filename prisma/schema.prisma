generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PHARMACIST
  CASHIER
  INVENTORY_MANAGER
  MANAGER
}

enum StockDirection {
  IN
  OUT
}

enum StockTransactionType {
  OPENING
  PURCHASE
  SALE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  EXPIRY
  DISPOSAL
  CORRECTION
  RETURN_TO_SUPPLIER
  CLEARANCE_SALE
}

enum TransferStatus {
  DRAFT
  PENDING
  COMPLETED
  CANCELLED
}

enum ExpiryActionType {
  RETURN_TO_SUPPLIER
  CLEARANCE_SALE
  DISPOSE
}

// ============================================================
// Purchasing & Supplier Management (Phase 3)
// ============================================================

enum PurchaseRequirementStatus {
  OPEN
  ASSIGNED
  CLOSED
}

enum PurchaseRequirementReason {
  LOW_STOCK
  REORDER_ALERT
  MANUAL
}

enum PurchaseOrderStatus {
  REGISTERED
  AWAITING_DELIVERY
  RECEIVED
  CLOSED
  CANCELLED
}

enum GoodsReceiptStatus {
  MATCHED
  DISCREPANCY
  RESOLVED
}

enum SupplierInvoiceStatus {
  OPEN
  PARTIALLY_PAID
  PAID
}

enum PurchaseReturnReason {
  EXPIRED
  DAMAGED
  INCORRECT_DELIVERY
}

model User {
  id                        String              @id
  name                      String
  email                     String
  emailVerified             Boolean             @default(false)
  image                     String?
  role                      UserRole            @default(ADMIN)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  sessions                  Session[]
  accounts                  Account[]
  stockTransactions         StockTransaction[]
  stockTransfers            StockTransfer[]     @relation("CreatedStockTransfers")
  expiryActions             ExpiryAction[]      @relation("PerformedExpiryActions")
  purchaseRequirements      PurchaseRequirement[] @relation("CreatedPurchaseRequirements")
  purchaseOrders            PurchaseOrder[]     @relation("CreatedPurchaseOrders")
  goodsReceipts             GoodsReceipt[]      @relation("CreatedGoodsReceipts")
  confirmedGoodsReceipts    GoodsReceipt[]      @relation("ConfirmedGoodsReceipts")
  supplierInvoices          SupplierInvoice[]   @relation("CreatedSupplierInvoices")
  supplierPayments          SupplierPayment[]   @relation("RecordedSupplierPayments")
  purchaseReturns           PurchaseReturn[]    @relation("RecordedPurchaseReturns")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// Inventory core domain (Phase 1)
//
// Single-tenant today: no Business/Organization model exists in
// the auth foundation. Uniqueness is therefore global. When a
// tenant layer is introduced, scope columns (businessId) must be
// added and folded into these unique constraints.
// ============================================================

model ProductGroup {
  id                  String    @id @default(uuid())
  name                String
  description         String?
  defaultProfitMargin Decimal   @default(0) @db.Decimal(5, 2)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  products            Product[]

  @@unique([name])
  @@index([isActive])
  @@map("product_group")
}

model Product {
  id            String    @id @default(uuid())
  name          String
  genericName   String?
  brand         String?
  sku           String
  description   String?
  imageUrl      String?
  minimumStock  Decimal   @default(0) @db.Decimal(14, 3)
  reorderPoint  Decimal?  @db.Decimal(14, 3)
  isActive      Boolean   @default(true)
  productGroupId String
  productGroup  ProductGroup @relation(fields: [productGroupId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  units                      ProductUnit[]
  batches                    Batch[]
  stock                      InventoryStock[]
  transactions               StockTransaction[]
  transferItems              StockTransferItem[]
  reorderConfig              ReorderConfiguration?
  purchaseRequirementLines   PurchaseRequirementLine[]
  purchaseOrderItems         PurchaseOrderItem[]
  purchaseReturns            PurchaseReturn[]

  @@unique([sku])
  @@index([productGroupId])
  @@index([name])
  @@index([isActive])
  @@map("product")
}

model ProductUnit {
  id               String  @id @default(uuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  name             String
  // 1 unit = conversionFactor x base units
  conversionFactor Decimal @db.Decimal(12, 4)
  sellPrice        Decimal? @db.Decimal(12, 2)
  purchasePrice    Decimal? @db.Decimal(12, 2)
  isBaseUnit       Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Exactly one base unit per product is enforced by a partial
  // unique index added in the migration (Prisma cannot express it).
  @@unique([productId, name])
  @@index([productId, isBaseUnit])
  @@map("product_unit")
}

model InventoryLocation {
  id           String    @id @default(uuid())
  name         String
  description  String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  stock        InventoryStock[]
  transactions StockTransaction[]
  fromTransfers StockTransfer[] @relation("FromLocation")
  toTransfers   StockTransfer[] @relation("ToLocation")
  expiryActions ExpiryAction[]
  goodsReceiptItems GoodsReceiptItem[]
  purchaseReturns PurchaseReturn[]

  @@unique([name])
  @@index([isActive])
  @@map("inventory_location")
}

model Batch {
  id                String    @id @default(uuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  batchNumber       String
  manufacturingDate DateTime?
  receivedDate      DateTime?
  expiryDate        DateTime
  purchaseCost      Decimal?  @db.Decimal(12, 2)
  supplierReference String?
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  stock             InventoryStock[]
  transactions      StockTransaction[]
  transferItems     StockTransferItem[]
  expiryActions     ExpiryAction[]
  goodsReceiptItems GoodsReceiptItem[]
  purchaseReturns   PurchaseReturn[]

  @@unique([productId, batchNumber])
  @@index([productId, expiryDate])
  @@index([batchNumber])
  @@map("batch")
}

model InventoryStock {
  id               String           @id @default(uuid())
  // productId mirrors batch.productId so stock can be queried by
  // product without joining through the batch.
  productId        String
  product          Product          @relation(fields: [productId], references: [id])
  batchId          String
  batch            Batch            @relation(fields: [batchId], references: [id])
  locationId       String
  location         InventoryLocation @relation(fields: [locationId], references: [id])
  // Quantities are always stored in the product base unit.
  quantity         Decimal          @default(0) @db.Decimal(14, 3)
  reservedQuantity Decimal          @default(0) @db.Decimal(14, 3)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // A batch belongs to a single product, so (batchId, locationId)
  // fully identifies one Product+Batch+Location stock record.
  @@unique([batchId, locationId])
  @@index([productId])
  @@index([locationId])
  @@map("inventory_stock")
}

model StockTransaction {
  id              String              @id @default(uuid())
  productId       String
  product         Product             @relation(fields: [productId], references: [id])
  batchId         String
  batch           Batch               @relation(fields: [batchId], references: [id])
  locationId      String
  location        InventoryLocation   @relation(fields: [locationId], references: [id])
  transactionType StockTransactionType
  direction       StockDirection
  // Always positive; direction decides increase/decrease.
  quantity        Decimal             @db.Decimal(14, 3)
  balanceAfter    Decimal             @db.Decimal(14, 3)
  referenceType   String?
  referenceId     String?
  notes           String?
  createdById     String
  createdBy       User                @relation(fields: [createdById], references: [id])
  createdAt       DateTime            @default(now())

  @@index([productId, createdAt])
  @@index([batchId, createdAt])
  @@index([locationId, createdAt])
  @@index([transactionType])
  @@index([createdById])
  @@map("stock_transaction")
}

// ============================================================
// Inventory Operations & Expiry Control (Phase 2)
// ============================================================

model StockTransfer {
  id              String    @id @default(uuid())
  fromLocationId  String
  fromLocation    InventoryLocation @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId    String
  toLocation      InventoryLocation @relation("ToLocation", fields: [toLocationId], references: [id])
  transferDate    DateTime  @default(now())
  reason          String?
  status          TransferStatus @default(DRAFT)
  createdById     String
  createdBy       User      @relation("CreatedStockTransfers", fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  items           StockTransferItem[]

  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
  @@index([createdById])
  @@map("stock_transfer")
}

model StockTransferItem {
  id           String    @id @default(uuid())
  transferId   String
  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  batchId      String
  batch        Batch     @relation(fields: [batchId], references: [id])
  quantity     Decimal   @db.Decimal(14, 3)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([transferId, productId, batchId])
  @@index([transferId])
  @@index([productId])
  @@index([batchId])
  @@map("stock_transfer_item")
}

model ExpiryAction {
  id               String    @id @default(uuid())
  batchId          String
  batch            Batch     @relation(fields: [batchId], references: [id])
  actionType       ExpiryActionType
  quantity         Decimal?  @db.Decimal(14, 3)
  locationId       String?
  location         InventoryLocation? @relation(fields: [locationId], references: [id])
  supplierId       String?
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  discountPercent  Decimal?  @db.Decimal(5, 2)
  reason           String?
  notes            String?
  performedById    String
  performedBy      User      @relation("PerformedExpiryActions", fields: [performedById], references: [id])
  createdAt        DateTime  @default(now())

  @@index([batchId])
  @@index([actionType])
  @@index([performedById])
  @@map("expiry_action")
}

model ReorderConfiguration {
  id                String  @id @default(uuid())
  productId         String  @unique
  product           Product @relation(fields: [productId], references: [id])
  minimumStockLevel Decimal @db.Decimal(14, 3)
  reorderPoint      Decimal @db.Decimal(14, 3)
  leadTimeDays      Int     @default(7)
  reorderQuantity   Decimal @db.Decimal(14, 3)
  useSalesVelocity  Boolean @default(false)
  bufferPercentage  Decimal @default(20) @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("reorder_configuration")
}

// ============================================================
// Purchasing & Supplier Management (Phase 3)
// ============================================================

model Supplier {
  id             String   @id @default(uuid())
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  paymentTerms   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  batches            Batch[]
  expiryActions      ExpiryAction[]
  requirements       PurchaseRequirementLine[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  supplierInvoices   SupplierInvoice[]
  supplierPayments   SupplierPayment[]
  purchaseReturns    PurchaseReturn[]

  @@unique([name])
  @@index([isActive])
  @@map("supplier")
}

model PurchaseRequirement {
  id         String   @id @default(uuid())
  reference  String
  status     PurchaseRequirementStatus @default(OPEN)
  requiredBy DateTime?
  notes      String?
  createdById String
  createdBy  User     @relation("CreatedPurchaseRequirements", fields: [createdById], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lines      PurchaseRequirementLine[]

  @@unique([reference])
  @@index([status])
  @@index([createdById])
  @@map("purchase_requirement")
}

model PurchaseRequirementLine {
  id                  String   @id @default(uuid())
  requirementId       String
  requirement         PurchaseRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  quantityNeeded      Decimal  @db.Decimal(14, 3)
  quantityDelivered   Decimal  @default(0) @db.Decimal(14, 3)
  reasonCode          PurchaseRequirementReason?
  supplierId          String?
  supplier            Supplier? @relation(fields: [supplierId], references: [id])
  status              PurchaseRequirementStatus @default(OPEN)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  purchaseOrderItems  PurchaseOrderItem[]

  @@unique([requirementId, productId])
  @@index([productId])
  @@index([supplierId])
  @@map("purchase_requirement_line")
}

model PurchaseOrder {
  id                    String   @id @default(uuid())
  poNumber              String
  supplierId            String
  supplier              Supplier @relation(fields: [supplierId], references: [id])
  status                PurchaseOrderStatus @default(REGISTERED)
  orderDate             DateTime @default(now())
  expectedDeliveryDate  DateTime?
  notes                 String?
  createdById           String
  createdBy             User     @relation("CreatedPurchaseOrders", fields: [createdById], references: [id])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  items                 PurchaseOrderItem[]
  goodsReceipts         GoodsReceipt[]
  supplierInvoices      SupplierInvoice[]

  @@unique([poNumber])
  @@index([supplierId])
  @@index([status])
  @@index([createdById])
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id                    String   @id @default(uuid())
  purchaseOrderId       String
  purchaseOrder         PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  requirementLineId     String?
  requirementLine       PurchaseRequirementLine? @relation(fields: [requirementLineId], references: [id], onDelete: SetNull)
  productId             String
  product               Product  @relation(fields: [productId], references: [id])
  quantityOrdered       Decimal  @db.Decimal(14, 3)
  quantityReceived      Decimal  @default(0) @db.Decimal(14, 3)
  unitCost              Decimal  @db.Decimal(12, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  goodsReceiptItems     GoodsReceiptItem[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([requirementLineId])
  @@map("purchase_order_item")
}

model GoodsReceipt {
  id              String   @id @default(uuid())
  receiptNumber   String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  receivedDate    DateTime @default(now())
  status          GoodsReceiptStatus @default(MATCHED)
  discrepancyNote String?
  confirmedById   String?
  confirmedBy     User?    @relation("ConfirmedGoodsReceipts", fields: [confirmedById], references: [id])
  createdById     String
  createdBy       User     @relation("CreatedGoodsReceipts", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  items           GoodsReceiptItem[]

  @@unique([receiptNumber])
  @@index([purchaseOrderId])
  @@index([status])
  @@map("goods_receipt")
}

model GoodsReceiptItem {
  id                  String   @id @default(uuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  locationId          String
  location            InventoryLocation @relation(fields: [locationId], references: [id])
  expectedQty         Decimal  @db.Decimal(14, 3)
  deliveredQty        Decimal  @db.Decimal(14, 3)
  actualQty           Decimal  @db.Decimal(14, 3)
  unitCost            Decimal  @db.Decimal(12, 2)
  batchNumber         String?
  manufacturingDate   DateTime?
  expiryDate          DateTime?
  batchId             String?
  batch               Batch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([goodsReceiptId, purchaseOrderItemId])
  @@index([purchaseOrderItemId])
  @@index([batchId])
  @@map("goods_receipt_item")
}

model SupplierInvoice {
  id                  String   @id @default(uuid())
  invoiceNumber       String
  supplierId          String
  supplier            Supplier @relation(fields: [supplierId], references: [id])
  purchaseOrderId     String?
  purchaseOrder       PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  invoiceDate         DateTime @default(now())
  dueDate             DateTime?
  invoiceAmount       Decimal  @db.Decimal(12, 2)
  paymentTerms        String?
  outstandingBalance  Decimal  @db.Decimal(12, 2)
  status              SupplierInvoiceStatus @default(OPEN)
  createdById         String
  createdBy           User     @relation("CreatedSupplierInvoices", fields: [createdById], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  payments            SupplierPayment[]

  @@unique([supplierId, invoiceNumber])
  @@index([supplierId])
  @@index([status])
  @@map("supplier_invoice")
}

model SupplierPayment {
  id                  String   @id @default(uuid())
  supplierInvoiceId   String
  supplierInvoice     SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)
  supplierId          String
  supplier            Supplier @relation(fields: [supplierId], references: [id])
  amount              Decimal  @db.Decimal(12, 2)
  paymentDate         DateTime @default(now())
  notes               String?
  recordedById        String
  recordedBy          User     @relation("RecordedSupplierPayments", fields: [recordedById], references: [id])
  createdAt           DateTime @default(now())

  @@index([supplierInvoiceId])
  @@map("supplier_payment")
}

model PurchaseReturn {
  id              String   @id @default(uuid())
  returnNumber    String
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  batchId         String?
  batch           Batch?   @relation(fields: [batchId], references: [id])
  locationId      String
  location        InventoryLocation @relation(fields: [locationId], references: [id])
  reason          PurchaseReturnReason
  quantity        Decimal  @db.Decimal(14, 3)
  returnedDate    DateTime @default(now())
  debitNoteAmount Decimal  @db.Decimal(12, 2)
  unitCost        Decimal  @db.Decimal(12, 2)
  notes           String?
  recordedById    String
  recordedBy      User     @relation("RecordedPurchaseReturns", fields: [recordedById], references: [id])
  createdAt       DateTime @default(now())

  @@index([supplierId])
  @@index([productId])
  @@index([batchId])
  @@map("purchase_return")
}
