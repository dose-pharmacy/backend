generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PHARMACIST
  CASHIER
  INVENTORY_MANAGER
  MANAGER
}

enum StockDirection {
  IN
  OUT
}

enum StockTransactionType {
  OPENING
  PURCHASE
  SALE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN_IN
  RETURN_OUT
  EXPIRY
  DISPOSAL
  CORRECTION
  RETURN_TO_SUPPLIER
  CLEARANCE_SALE
}

enum TransferStatus {
  DRAFT
  PENDING
  COMPLETED
  CANCELLED
}

enum ExpiryActionType {
  RETURN_TO_SUPPLIER
  CLEARANCE_SALE
  DISPOSE
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  DIGITAL_TRANSFER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model User {
  id                String              @id
  name              String
  email             String
  emailVerified     Boolean             @default(false)
  image             String?
  role              UserRole            @default(ADMIN)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  sessions          Session[]
  accounts          Account[]
  stockTransactions StockTransaction[]
  stockTransfers    StockTransfer[]     @relation("CreatedStockTransfers")
  expiryActions     ExpiryAction[]      @relation("PerformedExpiryActions")
  cashierSales      Sale[]              @relation("CashierSales")
  cancelledSales    Sale[]              @relation("CancelledSales")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// Inventory core domain (Phase 1)
//
// Single-tenant today: no Business/Organization model exists in
// the auth foundation. Uniqueness is therefore global. When a
// tenant layer is introduced, scope columns (businessId) must be
// added and folded into these unique constraints.
// ============================================================

model ProductGroup {
  id                  String    @id @default(uuid())
  name                String
  description         String?
  defaultProfitMargin Decimal   @default(0) @db.Decimal(5, 2)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  products            Product[]

  @@unique([name])
  @@index([isActive])
  @@map("product_group")
}

// Reusable master unit (e.g. "Tablet", "Strip", "Box", "Bottle", "Vial",
// "ml", "mg"). A Unit is the reusable concept only; product-specific
// configuration (conversion factor, prices, base-unit flag) lives on
// ProductUnit. Units are deactivated (soft-deleted) rather than hard-deleted
// so historical transfer audit rows keep their meaning.
model Unit {
  id          String    @id @default(uuid())
  name        String
  symbol      String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  productUnits  ProductUnit[]
  transferItems StockTransferItem[]
  saleItems     SaleItem[]

  @@unique([name])
  @@index([isActive])
  @@map("unit")
}

model Product {
  id            String    @id @default(uuid())
  name          String
  genericName   String?
  brand         String?
  sku           String
  description   String?
  imageUrl      String?
  minimumStock  Decimal   @default(0) @db.Decimal(14, 3)
  reorderPoint  Decimal?  @db.Decimal(14, 3)
  isActive      Boolean   @default(true)
  productGroupId String
  productGroup  ProductGroup @relation(fields: [productGroupId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  units              ProductUnit[]
  batches            Batch[]
  stock              InventoryStock[]
  transactions       StockTransaction[]
  transferItems      StockTransferItem[]
  reorderConfig      ReorderConfiguration?
  saleItems          SaleItem[]

  @@unique([sku])
  @@index([productGroupId])
  @@index([name])
  @@index([isActive])
  @@map("product")
}

// Product-specific configuration of a reusable master Unit.
//   Unit "Box" + ProductUnit(Paracetamol, Box, conversionFactor=100)
//   Unit "Box" + ProductUnit(Ibuprofen,  Box, conversionFactor=50)
//
// conversionFactor: how many BASE units this unit equals (1 unit = factor x
// base units). The base unit always has conversionFactor = 1.
//
// purchasePrice is the DEFAULT / reference purchase price for this product
// unit. It is NOT the authoritative historical inventory cost — the actual
// cost of received stock is recorded on the Batch (purchaseCost).
model ProductUnit {
  id               String  @id @default(uuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  unitId           String
  unit             Unit    @relation(fields: [unitId], references: [id])
  conversionFactor Decimal @db.Decimal(12, 4)
  sellPrice        Decimal? @db.Decimal(12, 2)
  purchasePrice    Decimal? @db.Decimal(12, 2)
  isBaseUnit       Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // The same master unit may only be configured once per product.
  @@unique([productId, unitId])
  // Exactly one base unit per product is enforced by a partial
  // unique index added in the migration (Prisma cannot express it).
  @@index([productId, isBaseUnit])
  @@index([unitId])
  @@map("product_unit")
}

model InventoryLocation {
  id           String    @id @default(uuid())
  name         String
  description  String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  stock        InventoryStock[]
  transactions StockTransaction[]
  fromTransfers StockTransfer[] @relation("FromLocation")
  toTransfers   StockTransfer[] @relation("ToLocation")
  expiryActions ExpiryAction[]
  sales         Sale[]

  @@unique([name])
  @@index([isActive])
  @@map("inventory_location")
}

model Batch {
  id                String    @id @default(uuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  batchNumber       String
  manufacturingDate DateTime?
  receivedDate      DateTime?
  expiryDate        DateTime
  purchaseCost      Decimal?  @db.Decimal(12, 2)
  supplierReference String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  stock             InventoryStock[]
  transactions      StockTransaction[]
  transferItems     StockTransferItem[]
  expiryActions     ExpiryAction[]
  saleItemBatches   SaleItemBatch[]

  @@unique([productId, batchNumber])
  @@index([productId, expiryDate])
  @@index([batchNumber])
  @@map("batch")
}

model InventoryStock {
  id               String           @id @default(uuid())
  // productId mirrors batch.productId so stock can be queried by
  // product without joining through the batch.
  productId        String
  product          Product          @relation(fields: [productId], references: [id])
  batchId          String
  batch            Batch            @relation(fields: [batchId], references: [id])
  locationId       String
  location         InventoryLocation @relation(fields: [locationId], references: [id])
  // Quantities are always stored in the product base unit.
  quantity         Decimal          @default(0) @db.Decimal(14, 3)
  reservedQuantity Decimal          @default(0) @db.Decimal(14, 3)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // A batch belongs to a single product, so (batchId, locationId)
  // fully identifies one Product+Batch+Location stock record.
  @@unique([batchId, locationId])
  @@index([productId])
  @@index([locationId])
  @@map("inventory_stock")
}

model StockTransaction {
  id              String              @id @default(uuid())
  productId       String
  product         Product             @relation(fields: [productId], references: [id])
  batchId         String
  batch           Batch               @relation(fields: [batchId], references: [id])
  locationId      String
  location        InventoryLocation   @relation(fields: [locationId], references: [id])
  transactionType StockTransactionType
  direction       StockDirection
  // Always positive; direction decides increase/decrease.
  quantity        Decimal             @db.Decimal(14, 3)
  balanceAfter    Decimal             @db.Decimal(14, 3)
  referenceType   String?
  referenceId     String?
  notes           String?
  createdById     String
  createdBy       User                @relation(fields: [createdById], references: [id])
  createdAt       DateTime            @default(now())

  @@index([productId, createdAt])
  @@index([batchId, createdAt])
  @@index([locationId, createdAt])
  @@index([transactionType])
  @@index([createdById])
  @@map("stock_transaction")
}

// ============================================================
// Inventory Operations & Expiry Control (Phase 2)
// ============================================================

model StockTransfer {
  id              String    @id @default(uuid())
  fromLocationId  String
  fromLocation    InventoryLocation @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId    String
  toLocation      InventoryLocation @relation("ToLocation", fields: [toLocationId], references: [id])
  transferDate    DateTime  @default(now())
  reason          String?
  status          TransferStatus @default(DRAFT)
  createdById     String
  createdBy       User      @relation("CreatedStockTransfers", fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  items           StockTransferItem[]

  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([status])
  @@index([createdById])
  @@map("stock_transfer")
}

// A transfer line item keeps BOTH representations for auditability:
//   quantity     = quantity entered by the user (in `unit`)
//   unitId       = the master unit selected by the user (e.g. "Box")
//   baseQuantity = quantity normalised to the product base unit at the time
//                  the item was entered (e.g. 2 Boxes x 100 = 200 Tablets)
// Stock movements always operate on baseQuantity; the entered quantity/unit
// are preserved so history can display "Transferred 5 Boxes (= 500 Tablets)"
// without re-deriving from the (possibly changed) ProductUnit conversion.
model StockTransferItem {
  id           String    @id @default(uuid())
  transferId   String
  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  batchId      String
  batch        Batch     @relation(fields: [batchId], references: [id])
  unitId       String
  unit         Unit      @relation(fields: [unitId], references: [id])
  quantity     Decimal   @db.Decimal(14, 3)
  baseQuantity Decimal   @db.Decimal(14, 3)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // One entry per product + batch + unit within a transfer.
  @@unique([transferId, productId, batchId, unitId])
  @@index([transferId])
  @@index([productId])
  @@index([batchId])
  @@index([unitId])
  @@map("stock_transfer_item")
}

model ExpiryAction {
  id               String    @id @default(uuid())
  batchId          String
  batch            Batch     @relation(fields: [batchId], references: [id])
  actionType       ExpiryActionType
  quantity         Decimal?  @db.Decimal(14, 3)
  locationId       String?
  location         InventoryLocation? @relation(fields: [locationId], references: [id])
  supplierId       String?
  discountPercent  Decimal?  @db.Decimal(5, 2)
  reason           String?
  notes            String?
  performedById    String
  performedBy      User      @relation("PerformedExpiryActions", fields: [performedById], references: [id])
  createdAt        DateTime  @default(now())

  @@index([batchId])
  @@index([actionType])
  @@index([performedById])
  @@map("expiry_action")
}

model ReorderConfiguration {
  id                String  @id @default(uuid())
  productId         String  @unique
  product           Product @relation(fields: [productId], references: [id])
  minimumStockLevel Decimal @db.Decimal(14, 3)
  reorderPoint      Decimal @db.Decimal(14, 3)
  leadTimeDays      Int     @default(7)
  reorderQuantity   Decimal @db.Decimal(14, 3)
  useSalesVelocity  Boolean @default(false)
  bufferPercentage  Decimal @default(20) @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("reorder_configuration")
}

// ============================================================
// Retail Point of Sale (POS)
//
// A Sale is completed ATOMICALLY: sale + items + batch allocations +
// payments are created and stock is deducted (SALE/OUT movements through
// the central stock movement engine) in ONE database transaction. There is
// never a completed sale without its stock movements, and never stock
// deducted without a completed sale.
//
// Historical accuracy: SaleItem stores the entered quantity + selected unit
// (quantity/unitId), the normalized base quantity (baseQuantity), the
// conversion factor used at sale time, and both the configured price
// (originalUnitPrice = ProductUnit.sellPrice) and the price actually charged
// (actualUnitPrice, after any override). Completed sales never depend on the
// current ProductUnit configuration for reconstruction.
//
// purchasePrice on ProductUnit is a DEFAULT/reference price only; the actual
// cost of sold stock remains on the Batch (purchaseCost).
// ============================================================

model Sale {
  id               String         @id @default(uuid())
  // Human-readable receipt number, e.g. "SL-20260910-3F2A9B".
  saleNumber       String         @unique
  locationId       String
  location         InventoryLocation @relation(fields: [locationId], references: [id])
  status           SaleStatus     @default(DRAFT)
  // Sum of item line totals BEFORE discounts.
  subtotal         Decimal        @db.Decimal(12, 2)
  // Sum of item discounts + bill discount.
  totalDiscount    Decimal        @default(0) @db.Decimal(12, 2)
  // Amount actually charged to the customer.
  totalAmount      Decimal        @db.Decimal(12, 2)
  // Sum of all SalePayment amounts.
  paidAmount       Decimal        @default(0) @db.Decimal(12, 2)
  // Excess of total payments over totalAmount (cash overpayment etc.).
  changeAmount     Decimal        @default(0) @db.Decimal(12, 2)
  // Bill-level discount applied to the whole sale (optional).
  billDiscountType DiscountType?
  billDiscountValue Decimal?      @db.Decimal(12, 2)
  cashierId        String
  cashier          User           @relation("CashierSales", fields: [cashierId], references: [id])
  notes            String?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancelledById    String?
  cancelledBy      User?          @relation("CancelledSales", fields: [cancelledById], references: [id])
  cancelReason     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items    SaleItem[]
  payments SalePayment[]

  @@index([locationId])
  @@index([status])
  @@index([cashierId])
  @@index([createdAt])
  @@map("sale")
}

model SaleItem {
  id                String      @id @default(uuid())
  saleId            String
  sale              Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId         String
  product           Product     @relation(fields: [productId], references: [id])
  unitId            String
  unit              Unit        @relation(fields: [unitId], references: [id])
  // Quantity entered by the cashier, in the selected unit.
  quantity          Decimal     @db.Decimal(14, 3)
  // Quantity normalized to the product base unit at sale time.
  baseQuantity      Decimal     @db.Decimal(14, 3)
  // ProductUnit conversion factor used at sale time (baseQuantity = quantity x factor).
  conversionFactor  Decimal     @db.Decimal(12, 4)
  // ProductUnit.sellPrice at sale time (configured price).
  originalUnitPrice Decimal     @db.Decimal(12, 2)
  // Price actually charged (equals originalUnitPrice unless overridden).
  actualUnitPrice   Decimal     @db.Decimal(12, 2)
  // Item-level discount (optional).
  discountType      DiscountType?
  discountValue     Decimal?    @db.Decimal(12, 2)
  discountAmount    Decimal     @default(0) @db.Decimal(12, 2)
  // Final line total after the item discount: actualUnitPrice x quantity - discountAmount.
  lineTotal         Decimal     @db.Decimal(12, 2)
  createdAt         DateTime    @default(now())

  batchAllocations SaleItemBatch[]

  @@index([saleId])
  @@index([productId])
  @@index([unitId])
  @@map("sale_item")
}

// One row per Batch consumed by a SaleItem (FEFO allocation at sale time).
// A single sale item can therefore span several batches; cashiers never pick
// batches manually.
model SaleItemBatch {
  id           String  @id @default(uuid())
  saleItemId   String
  saleItem     SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  batchId      String
  batch        Batch   @relation(fields: [batchId], references: [id])
  // Base-unit quantity taken from this batch.
  baseQuantity Decimal @db.Decimal(14, 3)
  createdAt    DateTime @default(now())

  @@unique([saleItemId, batchId])
  @@index([batchId])
  @@map("sale_item_batch")
}

// Split payments for a sale (CASH / CARD / DIGITAL_TRANSFER).
model SalePayment {
  id        String        @id @default(uuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  // Optional reference (card/transfer reference number).
  reference String?
  createdAt DateTime      @default(now())

  @@index([saleId])
  @@map("sale_payment")
}
