# Application
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug
BODY_LIMIT=100kb

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/pharmacy?schema=public

# Better Auth
# Generate a long random secret (at least 32 characters). Never commit the real value.
BETTER_AUTH_SECRET=ba_zqmupl37p0rln2lb8fl4vq4belo1l1ll
# Public URL of this API (used to build OAuth callback URLs)
BETTER_AUTH_URL=http://localhost:4000

# Google OAuth (from Google Cloud Console → Credentials → OAuth 2.0 Client)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend (CORS + OAuth redirects)
FRONTEND_URL=http://localhost:5173
# Optional extra allowed origins, comma-separated
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Cookies
# In production, cookies are Secure + SameSite=None by default.
# COOKIE_SECURE=true
