{
  "info": {
    "name": "Pharmacy Purchasing & Supplier Management API",
    "description": "Postman collection for Purchasing & Supplier Management module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "apiPrefix",
      "value": "/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "supplierId",
      "value": "",
      "type": "string"
    },
    {
      "key": "requirementId",
      "value": "",
      "type": "string"
    },
    {
      "key": "requirementLineId",
      "value": "",
      "type": "string"
    },
    {
      "key": "purchaseOrderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "goodsReceiptId",
      "value": "",
      "type": "string"
    },
    {
      "key": "invoiceId",
      "value": "",
      "type": "string"
    },
    {
      "key": "returnId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login (Email/Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/sign-in/email",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@pharmacy.com\",\n  \"password\": \"your-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const res = pm.response.json();",
                  "  if (res.session?.token) {",
                  "    pm.collectionVariables.set('authToken', res.session.token);",
                  "    console.log('Auth token saved');",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Suppliers",
      "item": [
        {
          "name": "List Suppliers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}{{apiPrefix}}/purchasing/suppliers?page=1&limit=20&search=",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          }
        },
        {
          "name": "Create Supplier",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}{{apiPrefix}}/purchasing/suppliers",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ABC Pharmaceuticals\",\n  \"contactPerson\": \"John Smith\",\n  \"email\": \"john@abcpharma.com\",\n  \"phone\": \"+251-911-123456\",\n  \"address\": \"Bole Road, Addis Ababa\",\n  \"paymentTerms\": \"Net 30\",\n  \"isActive\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const res = pm.response.json();",
                  "  pm.collectionVariables.set('supplierId', res.data.id);",
                  "  console.log('Supplier ID saved:', res.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Supplier by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}{{apiPrefix}}/purchasing/suppliers/{{supplierId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          }
        },
        {
          "name": "Update Supplier",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}{{apiPrefix}}/purchasing/suppliers/{{supplierId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contactPerson\": \"Jane Doe\",\n  \"phone\": \"+251-922-654321\",\n  \"paymentTerms\": \"Net 45\"\n}"
            }
          }
        },
        {
          "name": "Delete Supplier",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}{{apiPrefix}}/purchasing/suppliers/{{supplierId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          }
        }
      ]
    },
    {
